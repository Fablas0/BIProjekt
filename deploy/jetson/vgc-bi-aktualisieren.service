# Holt den taeglichen Datenstand: git pull (das Archiv pflegt GitHub Actions),
# danach Neuverarbeitung aus dem Archiv ohne Quellzugriff. Die Nutzerdatenbank
# ist nie betroffen.
[Unit]
Description=VGC BI: Datenstand aus dem Repository uebernehmen
After=network-online.target

[Service]
Type=oneshot
User=@NUTZER@
WorkingDirectory=@PROJEKT@
Environment=VGC_BI_DATA_DIR=@DATEN@
ExecStart=/usr/bin/git pull --ff-only
ExecStart=@PROJEKT@/.venv/bin/python -m scripts.etl_lauf --aus-archiv --ohne-spielformen
