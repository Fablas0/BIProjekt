{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // requirements-dev.txt bindet requirements.txt ueber "-r" mit ein und bringt
  // zusaetzlich pytest und ruff. Ohne diese beiden koennte eine Sitzung im
  // Container ihre eigene Arbeit nicht pruefen -- und genau das ist die
  // Voraussetzung, unter der hier gearbeitet wird.
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; pip3 install --user -r requirements-dev.txt; echo 'Abhaengigkeiten installiert -- pruefen mit: ruff check . && pytest -q'",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}